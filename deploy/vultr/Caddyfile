PUBLIC_HOST {
    request_body {
        max_size 25MB
    }
    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1
    }
}

# Chromium reaches these mock sites on the VM; do not expose them publicly.
http://portal.localhost, http://tracking.localhost, http://inbox.localhost, http://store.localhost {
    @external not remote_ip 127.0.0.1 ::1
    respond @external 403
    request_body {
        max_size 25MB
    }
    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1
    }
}
