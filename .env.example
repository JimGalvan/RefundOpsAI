# RefundOps environment. Copy this file to .env and fill it in. Never commit .env.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
# This build is sandbox-only on purpose.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only needed if you register a sandbox webhook (needs a public URL)
PAYPAL_WEBHOOK_ID=

# --- Models: LangChain provider:model strings ---
# Default provider is Vultr Serverless Inference. OpenAI works as a fallback.
VULTR_INFERENCE_API_KEY=
OPENAI_API_KEY=
REFUNDOPS_STRONG_MODEL=vultr:glm-5.3
REFUNDOPS_FAST_MODEL=vultr:glm-5.3-flash
REFUNDOPS_EVIDENCE_MODEL=vultr:glm-5.3-flash

# --- Credential vault key: base64 of 32 random bytes ---
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
REFUNDOPS_CREDENTIAL_KEY=

# --- Mock merchant sites the agent may visit (comma separated) ---
REFUNDOPS_SITE_HOSTS=portal.localhost,tracking.localhost,inbox.localhost,store.localhost

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# --- Demo video narration only ---
ELEVENLABS_API_KEY=
